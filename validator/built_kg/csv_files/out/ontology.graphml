<edge source="PositionContext::column_top@column" target="DamageMechanism::flexural" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">柱頂彎矩最大(反曲點在柱中央)軸力併合彎矩破壞保護層剝落</data>
</edge>
<edge source="PositionContext::column_bottom@column" target="DamageMechanism::flexural" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">柱底彎矩最大軸力併合彎矩破壞保護層剝落若箍筋不足主筋挫屈</data>
</edge>
<edge source="PositionContext::column_mid@column" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">柱中央未配置圍束箍筋箍筋間距大易剪力破壞斜裂縫寬表示剪力筋已降伏</data>
</edge>
<edge source="PositionContext::column_mid@column" target="DamageMechanism::short_column_effect" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">窗台或牆束制致短柱中央剪力控制破壞</data>
</edge>
<edge source="PositionContext::beam_end@beam" target="DamageMechanism::flexural" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">梁兩端彎矩最大端點彎矩破壞受壓側混凝土剝落正常塑鉸為III級</data>
</edge>
<edge source="PositionContext::beam_end@beam" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">梁端近柱大斜裂縫剪力破壞嚴重時連帶主筋下混凝土剝落</data>
</edge>
<edge source="PositionContext::beam_mid@beam" target="DamageMechanism::flexural" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">梁中央反曲點彎矩小無隔間牆長梁中央垂直裂紋</data>
</edge>
<edge source="PositionContext::beam_mid@beam" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">梁下有隔間磚牆(牆短於梁)留短梁產生大剪力剪力破壞</data>
</edge>
<edge source="PositionContext::joint_region@beam_column_joint" target="DamageMechanism::joint_failure" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">梁柱接頭斜裂或混凝土擠壓破碎無緊密圍束箍筋</data>
</edge>
<edge source="PositionContext::wall_center@shear_wall" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">牆中央斜裂縫寬大剪力筋降伏或握裹破壞嚴重剪力破壞</data>
</edge>
<edge source="PositionContext::wall_corner@shear_wall" target="DamageMechanism::axial_compression" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">牆兩端彎矩併合軸力破壞壓力側保護層剝落主筋挫屈核心爆裂</data>
</edge>
<edge source="PositionContext::wall_corner@shear_wall" target="DamageMechanism::flexural" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">牆拉力側主筋降伏續接不良可能拉斷</data>
</edge>
<edge source="PositionContext::opening_corner@shear_wall" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">開口角隅應力集中斜向裂縫</data>
</edge>
<edge source="PositionContext::wall_column_interface@spandrel_or_sill_wall" target="DamageMechanism::short_column_effect" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">窗台牆與柱交界束制柱形成短柱效應</data>
</edge>
<edge source="PositionContext::base@foundation_or_column_base" target="DamageMechanism::axial_compression" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">柱底或柱腳破壞基礎與上部結構脫離錯開</data>
</edge>
<edge source="PositionContext::mid_height@brace" target="DamageMechanism::buckling" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">鋼斜撐中段挫屈</data>
</edge>
<edge source="PositionContext::distributed@shear_wall" target="DamageMechanism::shear" id="0">
  <data key="d83">POSITION_IMPLIES_MECHANISM</data>
  <data key="d86">大量分布斜裂縫遍及牆面</data>
</edge>
