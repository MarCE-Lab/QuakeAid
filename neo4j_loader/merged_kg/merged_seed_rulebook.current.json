      "rule_id": "SEED_003",
      "description": "Exposed rebar — irrespective of element — indicates concrete cover loss and corrosion onset; minimum severity candidate is A. This is mandated by DATASET_SPEC §3 (鋼筋裸露 → damage_level must contain A).",
      "validator_grade": true,
