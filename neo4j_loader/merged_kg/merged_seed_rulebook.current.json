    {
      "rule_id": "SEED_001",
      "description": "X-shaped crack on a wall indicates shear failure under reversed-cyclic earthquake loading; in walls this constitutes plastic shear damage and maps to Severity Level A (immediate evacuation).",
      "validator_grade": true,
      "confidence": 0.97,
      "source": "civil_engineering_seed_rule",
      "rationale": "X形裂縫由雙向剪力作用造成；當其出現在牆體（剪力主導構件），代表結構已進入塑性破壞階段。ATC-20 與 Taiwan 耐震規範均判定貫穿性 X 形裂縫為 A 級損傷。",
      "source_rule_ids": [
        "terminology:SEED_001"
      ],
      "mapped_edge_ids": [
        "edge_final_000001",
        "edge_final_000002",
        "edge_final_000003",
        "edge_final_000004"
      ],
      "status": "accepted",
      "warnings": [],
      "if": {
        "element": "E_WALL",
        "pattern": "T_term_271"
      },
      "path": [
        [
          "E_WALL",
          "has_damage",
          "T_term_271"
        ],
        [
          "T_term_271",
          "indicates",
          "F_term_159"
